rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email, settings, friends, coaching data and match history are private.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      // Reward, streak and ranking fields are written only by trusted Functions.
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoURL', 'selectedAvatar', 'tag',
          'settings', 'friends', 'clubId'
        ]);

      match /matchHistory/{matchId} {
        allow read, write: if isOwner(uid);
      }
      match /coach/{coachId} {
        allow read, write: if isOwner(uid);
      }
      match /stats/{nested=**} {
        allow read, write: if isOwner(uid);
      }
      match /awards/{awardId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Search and leaderboards use a deliberately limited copy of a profile.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoURL', 'selectedAvatar', 'tag', 'clubId'
        ]);
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'members', 'totalXp', 'maxMembers', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.totalXp == 0
        && request.resource.data.maxMembers == 25
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members'])
        && (
          // A new member may only add themselves.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= resource.data.maxMembers
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          // A member may only remove themselves.
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members))
        ))
        || (request.auth.uid == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.ownerId in request.resource.data.members
          && request.resource.data.ownerId in resource.data.members)
      );
      allow delete: if isOwner(resource.data.ownerId)
        && resource.data.members == [request.auth.uid];
    }

    match /matches/{matchId} {
      function validRoomConfig(config) {
        return config.keys().hasOnly(['startingScore', 'setsToWin', 'legsToWin', 'checkIn', 'checkout'])
          && config.startingScore in [301, 501, 701, 1001]
          && config.setsToWin in [1, 3, 5]
          && config.legsToWin in [1, 3, 5]
          && config.checkIn in ['single', 'double', 'master']
          && config.checkout in ['single', 'double', 'master'];
      }

      function initialState(state) {
        return state.keys().hasOnly([
          'currentLeg', 'currentSet', 'hostDarts', 'guestDarts',
          'hostSetsWon', 'guestSetsWon', 'hostLegsWon', 'guestLegsWon', 'winner'
        ])
          && state.currentLeg == 1 && state.currentSet == 1
          && state.hostDarts == null && state.guestDarts == null
          && state.hostSetsWon == 0 && state.guestSetsWon == 0
          && state.hostLegsWon == 0 && state.guestLegsWon == 0
          && state.winner == null;
      }

      // A room can be opened by its unguessable invite code, but cannot be listed.
      allow get: if signedIn() && matchId.matches('DART-[0-9A-F]{12}');
      allow list: if false;
      allow create: if signedIn()
        && matchId.matches('DART-[0-9A-F]{12}')
        && request.resource.data.keys().hasOnly([
          'status', 'config', 'state', 'hostName', 'hostUid', 'guestName',
          'guestUid', 'createdAt'
        ])
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && validRoomConfig(request.resource.data.config)
        && initialState(request.resource.data.state)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.status == 'waiting'
          && resource.data.hostUid != request.auth.uid
          && resource.data.guestUid == null
          && request.resource.data.status == 'playing'
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'guestUid', 'guestName']);
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && (resource.data.status == 'waiting' || resource.data.state.winner != null);
    }
  }
}
