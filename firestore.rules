rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email, settings, friends, coaching data and match history are private.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /{nested=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Search and leaderboards use a deliberately limited copy of a profile.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'displayName', 'photoURL', 'selectedAvatar', 'tag', 'xp',
          'weeklyXp', 'matchesWon', 'matchesPlayed', 'totalDarts', 'totalPoints',
          'count100', 'count140', 'count180', 'checkoutAttempts',
          'checkoutSuccess', 'first9Points', 'first9Darts', 'highestCheckout',
          'clubId'
        ]);
      allow delete: if isOwner(uid);
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'totalXp'])
        && (
          // A new member may only add themselves.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          // A member may only remove themselves.
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members))
          // Existing client-side XP awards are capped per write.
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalXp'])
            && request.auth.uid in resource.data.members
            && request.resource.data.totalXp is number
            && request.resource.data.totalXp >= resource.data.totalXp
            && request.resource.data.totalXp <= resource.data.totalXp + 100)
        );
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /matches/{matchId} {
      // A room can be opened by its unguessable invite code, but cannot be listed.
      allow get: if signedIn() && matchId.matches('DART-[0-9A-F]{12}');
      allow list: if false;
      allow create: if signedIn()
        && matchId.matches('DART-[0-9A-F]{12}')
        && request.resource.data.keys().hasOnly([
          'status', 'config', 'state', 'hostName', 'hostUid', 'guestName',
          'guestUid', 'createdAt'
        ])
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (resource.data.status == 'waiting'
          && resource.data.hostUid != request.auth.uid
          && resource.data.guestUid == null
          && request.resource.data.status == 'playing'
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'guestUid', 'guestName']))
        || (resource.data.status == 'playing'
          && request.resource.data.status == 'playing'
          && (request.auth.uid == resource.data.hostUid
            || request.auth.uid == resource.data.guestUid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state'])
          && (request.auth.uid == resource.data.hostUid
            || (resource.data.state.winner == null
              && resource.data.state.guestDarts == null
              && request.resource.data.state.guestDarts is int
              && request.resource.data.state.guestDarts > 0
              && request.resource.data.state.diff(resource.data.state)
                .affectedKeys().hasOnly(['guestDarts']))))
      );
      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
