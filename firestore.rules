rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Email, settings, friends, coaching data and match history are private.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update, delete: if isOwner(uid);

      match /{nested=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Search and leaderboards use a deliberately limited copy of a profile.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'name', 'displayName', 'photoURL', 'selectedAvatar', 'tag', 'xp',
          'weeklyXp', 'matchesWon', 'matchesPlayed', 'totalDarts', 'totalPoints',
          'count100', 'count140', 'count180', 'checkoutAttempts',
          'checkoutSuccess', 'first9Points', 'first9Darts', 'highestCheckout',
          'clubId'
        ]);
      allow delete: if isOwner(uid);
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'ownerId', 'members', 'totalXp', 'maxMembers', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.totalXp == 0
        && request.resource.data.maxMembers == 25
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'totalXp'])
        && (
          // A new member may only add themselves.
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= resource.data.maxMembers
            && request.resource.data.members.hasAll(resource.data.members)
            && request.auth.uid in request.resource.data.members
            && !(request.auth.uid in resource.data.members))
          // A member may only remove themselves.
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.auth.uid in resource.data.members
            && !(request.auth.uid in request.resource.data.members))
          // Existing client-side XP awards are capped per write.
          || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['totalXp'])
            && request.auth.uid in resource.data.members
            && request.resource.data.totalXp is number
            && request.resource.data.totalXp >= resource.data.totalXp
            && request.resource.data.totalXp <= resource.data.totalXp + 100)
        ))
        || (request.auth.uid == resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'members'])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.members.hasAll(resource.data.members.removeAll([request.auth.uid]))
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.ownerId in request.resource.data.members
          && request.resource.data.ownerId in resource.data.members)
      );
      allow delete: if isOwner(resource.data.ownerId)
        && resource.data.members == [request.auth.uid];
    }

    match /matches/{matchId} {
      function validRoomConfig(config) {
        return config.keys().hasOnly(['startingScore', 'setsToWin', 'legsToWin', 'checkIn', 'checkout'])
          && config.startingScore in [301, 501, 701, 1001]
          && config.setsToWin in [1, 3, 5]
          && config.legsToWin in [1, 3, 5]
          && config.checkIn in ['single', 'double', 'master']
          && config.checkout in ['single', 'double', 'master'];
      }

      function initialState(state) {
        return state.keys().hasOnly([
          'currentLeg', 'currentSet', 'hostDarts', 'guestDarts',
          'hostSetsWon', 'guestSetsWon', 'hostLegsWon', 'guestLegsWon', 'winner'
        ])
          && state.currentLeg == 1 && state.currentSet == 1
          && state.hostDarts == null && state.guestDarts == null
          && state.hostSetsWon == 0 && state.guestSetsWon == 0
          && state.hostLegsWon == 0 && state.guestLegsWon == 0
          && state.winner == null;
      }

      function submittedOwnDarts(before, after, role) {
        return before.winner == null
          && before[role + 'Darts'] == null
          && after.diff(before).affectedKeys().hasOnly([role + 'Darts'])
          && after[role + 'Darts'] is int
          && after[role + 'Darts'] > 0
          && after[role + 'Darts'] <= 10000;
      }

      function resolvedState(before, after, config) {
        let winner = before.hostDarts <= before.guestDarts ? 'host' : 'guest';
        let hostLegs = before.hostLegsWon + (winner == 'host' ? 1 : 0);
        let guestLegs = before.guestLegsWon + (winner == 'guest' ? 1 : 0);
        let setEnded = (winner == 'host' ? hostLegs : guestLegs) >= config.legsToWin;
        let hostSets = before.hostSetsWon + (setEnded && winner == 'host' ? 1 : 0);
        let guestSets = before.guestSetsWon + (setEnded && winner == 'guest' ? 1 : 0);
        let matchEnded = (winner == 'host' ? hostSets : guestSets) >= config.setsToWin;
        return before.winner == null
          && before.hostDarts is int && before.guestDarts is int
          && after.diff(before).affectedKeys().hasOnly([
            'hostDarts', 'guestDarts', 'hostLegsWon', 'guestLegsWon',
            'hostSetsWon', 'guestSetsWon', 'currentLeg', 'resolvedLeg', 'winner'
          ])
          && after.hostDarts == null && after.guestDarts == null
          && after.hostLegsWon == (setEnded ? 0 : hostLegs)
          && after.guestLegsWon == (setEnded ? 0 : guestLegs)
          && after.hostSetsWon == hostSets && after.guestSetsWon == guestSets
          && after.currentLeg == before.currentLeg + 1
          && after.resolvedLeg.keys().hasOnly(['number', 'winner', 'setEnded', 'matchEnded'])
          && after.resolvedLeg.number == before.currentLeg
          && after.resolvedLeg.winner == winner
          && after.resolvedLeg.setEnded == setEnded
          && after.resolvedLeg.matchEnded == matchEnded
          && after.winner == (matchEnded ? winner : null);
      }

      // A room can be opened by its unguessable invite code, but cannot be listed.
      allow get: if signedIn() && matchId.matches('DART-[0-9A-F]{12}');
      allow list: if false;
      allow create: if signedIn()
        && matchId.matches('DART-[0-9A-F]{12}')
        && request.resource.data.keys().hasOnly([
          'status', 'config', 'state', 'hostName', 'hostUid', 'guestName',
          'guestUid', 'createdAt'
        ])
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && request.resource.data.guestUid == null
        && request.resource.data.guestName == null
        && validRoomConfig(request.resource.data.config)
        && initialState(request.resource.data.state)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && (
        (resource.data.status == 'waiting'
          && resource.data.hostUid != request.auth.uid
          && resource.data.guestUid == null
          && request.resource.data.status == 'playing'
          && request.resource.data.guestUid == request.auth.uid
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() > 0
          && request.resource.data.guestName.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'guestUid', 'guestName']))
        || (resource.data.status == 'playing'
          && request.resource.data.status == 'playing'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['state'])
          && (
            (request.auth.uid == resource.data.hostUid
              && submittedOwnDarts(resource.data.state, request.resource.data.state, 'host'))
            || (request.auth.uid == resource.data.guestUid
              && submittedOwnDarts(resource.data.state, request.resource.data.state, 'guest'))
            || (request.auth.uid == resource.data.hostUid
              && resolvedState(resource.data.state, request.resource.data.state, resource.data.config))
          ))
      );
      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && (resource.data.status == 'waiting' || resource.data.state.winner != null);
    }
  }
}
